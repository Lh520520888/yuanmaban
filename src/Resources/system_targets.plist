<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>_readme</key>
	<string>系统守护进程属地的库，全部在 /var/mobile/Library 下，不在任何 App 容器内 —— 通道 B（house_arrest 租约）永远够不到，只有内核通道拿到 root 之后才可读。requireRoot=YES 的条目在容器-only 场景下会被跳过并记 skip，不算失败。</string>
	<key>system</key>
	<array>
		<dict>
			<key>name</key><string>SMS</string>
			<key>requireRoot</key><true/>
			<key>paths</key>
			<array>
				<string>/var/mobile/Library/SMS/sms.db</string>
				<string>/var/mobile/Library/SMS/sms.db-wal</string>
				<string>/var/mobile/Library/SMS/sms.db-shm</string>
			</array>
		</dict>
		<dict>
			<key>name</key><string>AddressBook</string>
			<key>requireRoot</key><true/>
			<key>paths</key>
			<array>
				<string>/var/mobile/Library/AddressBook/AddressBook.sqlitedb</string>
				<string>/var/mobile/Library/AddressBook/AddressBookImages.sqlitedb</string>
				<string>/var/mobile/Library/Application Support/AddressBook/AddressBook.sqlitedb</string>
			</array>
		</dict>
		<dict>
			<key>name</key><string>CallHistory</string>
			<key>requireRoot</key><true/>
			<key>paths</key>
			<array>
				<string>/var/mobile/Library/CallHistoryDB/CallHistory.storedata</string>
				<string>/var/mobile/Library/CallHistoryDB/CallHistory.storedata-wal</string>
				<string>/var/mobile/Library/CallHistoryDB/CallHistory.storedata-shm</string>
			</array>
		</dict>
		<dict>
			<key>name</key><string>Safari</string>
			<key>requireRoot</key><true/>
			<key>paths</key>
			<array>
				<string>/var/mobile/Library/Safari/History.db</string>
				<string>/var/mobile/Library/Safari/Bookmarks.db</string>
				<string>/var/mobile/Library/Safari/History.db-wal</string>
			</array>
		</dict>
		<dict>
			<key>name</key><string>Calendar</string>
			<key>requireRoot</key><true/>
			<key>paths</key>
			<array>
				<string>/var/mobile/Library/Calendar/Calendar.sqlitedb</string>
			</array>
		</dict>
		<dict>
			<key>name</key><string>Photos</string>
			<key>requireRoot</key><true/>
			<key>paths</key>
			<array>
				<string>/var/mobile/Media/PhotoData/Photos.sqlite</string>
				<string>/var/mobile/Media/PhotoData/Photos.sqlite-wal</string>
			</array>
		</dict>
		<dict>
			<key>name</key><string>Health</string>
			<key>requireRoot</key><true/>
			<key>paths</key>
			<array>
				<string>/var/mobile/Library/Health/healthdb.sqlite</string>
				<string>/var/mobile/Library/Health/healthdb_secure.sqlite</string>
			</array>
		</dict>
		<dict>
			<key>name</key><string>MailIndex</string>
			<key>requireRoot</key><true/>
			<key>paths</key>
			<array>
				<string>/var/mobile/Library/Mail/Indexed/Index.db</string>
			</array>
		</dict>
		<dict>
			<key>name</key><string>Keychains</string>
			<key>requireRoot</key><true/>
			<key>dirs</key>
			<array>
				<string>/var/mobile/Library/Keychains</string>
			</array>
		</dict>
		<dict>
			<key>name</key><string>UserDictionary</string>
			<key>requireRoot</key><true/>
			<key>paths</key>
			<array>
				<string>/var/mobile/Library/UserDictionary/user_dictionary.db</string>
			</array>
		</dict>
		<dict>
			<key>name</key><string>NotesLegacy</string>
			<key>requireRoot</key><true/>
			<key>paths</key>
			<array>
				<string>/var/mobile/Library/Notes/notes.sqlite</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
